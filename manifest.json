{
  "schemaVersion": 1,
  "id": "dev.enkeli.nextcloud.tasks",
  "name": "Nextcloud Tasks",
  "version": "0.0.4",
  "author": "dev.enkeli.nextcloud.tasks",
  "license": "MIT",
  "description": "Sync Nextcloud tasks to the Omarchy bar widget.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Nextcloud Tasks",
    "description": "Clock popup with local calendar events",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "provider": "evolution-data-server",
      "maxUpcoming": 5,
      "maxDone": 10
    },
    "schema": [
      { "key": "provider", "type": "string", "label": "Provider" },
      { "key": "maxUpcoming", "type": "number", "label": "Max upcoming tasks" },
      { "key": "maxDone", "type": "number", "label": "Max completed tasks" }
    ]
  }
}
